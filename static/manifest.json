{
  "manifest_version": 3,
  "name": "Anti-Venom Ad Blocker",
  "short_name": "Anti-Venom",
  "version": "__VERSION__",
  "description": "Fast, privacy-first ad, tracker and malware blocker with per-site controls, powered by maintained filter lists.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "Anti-Venom",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png"
    }
  },
  "options_ui": {
    "page": "app/app.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["declarativeNetRequest", "storage", "unlimitedStorage", "scripting", "alarms", "webRequest", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": "__RULE_RESOURCES__"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
